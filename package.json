{
  "name": "shimmer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/images.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "prebuild": "npm run images && npm run sitemap && npm run validate:content",
    "build": "vite build",
    "lint": "eslint . && npm run validate:content",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5"
  }
}
